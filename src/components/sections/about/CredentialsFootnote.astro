---
import type { CollectionEntry } from "astro:content";

type Achievement = CollectionEntry<"achievements">;

interface Props {
  achievements: Achievement[];
}

const { achievements } = Astro.props;

// Newest first
const sorted = [...achievements].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
}
---

<section aria-labelledby="credentials-heading" class="space-y-6">
  <header class="space-y-1">
    <h2 id="credentials-heading" class="text-h2 font-display text-text font-bold tracking-tight">
      Footnote credentials
    </h2>
    <p class="text-body text-text-muted">
      Certifications treated as marginalia — they support the moves above, they do not lead them.
    </p>
  </header>

  <ul class="divide-border-custom border-border-custom divide-y border-y">
    {
      sorted.map((ach) => (
        <li class="group flex flex-col gap-x-6 gap-y-2 py-5 md:flex-row md:items-baseline md:justify-between">
          <div class="flex-1 space-y-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-caption text-text-muted font-mono font-bold tracking-wider">
                {formatDate(ach.data.date)}
              </span>
              <h3 class="text-h4 font-display text-text group-hover:text-primary font-bold transition-colors">
                {ach.data.title}
              </h3>
            </div>
            <p class="text-body text-text-muted max-w-[62ch] leading-relaxed">
              {ach.data.description}
            </p>
          </div>
          <div class="flex shrink-0 items-baseline gap-3">
            <span class="text-caption text-text-muted font-mono tracking-wider uppercase">
              {ach.data.issuer}
            </span>
            {ach.data.evidenceURL && (
              <a
                href={ach.data.evidenceURL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-caption text-primary focus-visible:outline-focus font-mono font-bold tracking-wider uppercase underline-offset-4 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                Verify →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
