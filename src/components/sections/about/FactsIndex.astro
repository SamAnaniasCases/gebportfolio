---
type Fact = { label: string; value: string };

interface Props {
  facts?: Fact[];
  signature?: string;
}

const { facts = [], signature = "Sam.A.Cases" } = Astro.props;
---

<aside
  class="border-border-custom bg-surface-subtle relative rounded-sm border-[1.5px] p-5 md:p-6"
  aria-labelledby="facts-index-heading"
>
  {/* Stamped corner ornament */}
  <span
    aria-hidden="true"
    class="border-border-custom bg-surface absolute -top-2 -right-2 flex size-7 items-center justify-center rounded-[2px] border"
  >
    <span class="bg-text block size-1.5"></span>
  </span>

  <h2
    id="facts-index-heading"
    class="text-caption text-text-muted mb-4 font-mono font-bold tracking-[0.16em] uppercase"
  >
    Quick reference index
  </h2>

  <dl class="space-y-3">
    {
      facts.map((fact) => (
        <div class="border-border-custom border-b border-dashed pb-2.5 last:border-none last:pb-0">
          <dt class="text-micro text-text-muted mb-1 font-mono font-bold tracking-[0.14em] uppercase">
            {fact.label}
          </dt>
          <dd class="text-small text-text leading-snug">{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  {/* Signature block */}
  <div class="border-border-custom mt-6 border-t pt-4">
    <p class="text-micro text-text-muted mb-1 font-mono font-bold tracking-[0.14em] uppercase">
      Authorised by
    </p>
    <p class="font-hand text-h4 text-primary origin-left -rotate-1">{signature}</p>
    <p class="text-micro text-text-muted mt-1 font-mono tracking-[0.14em] uppercase">
      Score sheet · v1.0
    </p>
  </div>
</aside>
