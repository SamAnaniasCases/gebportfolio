---
import Container from "../../primitives/Container.astro";
import InteractiveAvatar from "../../primitives/InteractiveAvatar.astro";
import { getEntry } from "astro:content";

const siteEntry = await getEntry("site", "site-config");
const siteConfig = siteEntry?.data;

const name = siteConfig?.name ?? "Sam Ananias Cases";
const location = siteConfig?.location ?? "Cebu, Philippines";
const headline = siteConfig?.headline ?? "Bachelor of Industrial Technology (Computer)";
---

<section class="relative overflow-hidden pt-8 pb-12 md:pt-12 md:pb-16">
  <Container width="default">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
      {/* Left: name, catchphrase, thesis */}
      <div class="space-y-6 lg:col-span-7">
        <div class="space-y-4">
          <h1
            class="text-h1 font-display text-text leading-[1.05] font-extrabold tracking-tight text-balance"
          >
            {name}
          </h1>
          <p
            class="font-hand text-h4 text-primary inline-block origin-left -rotate-1"
            aria-hidden="true"
          >
            think in systems, document the moves
          </p>
        </div>

        <p class="text-body-large text-text-muted max-w-2xl leading-relaxed">
          A score sheet of the career-in-progress: where I started, what I've shipped, and the
          discipline I'm building toward. Each move is numbered, deliberate, and revision-safe.
        </p>

        <div
          class="border-border-custom bg-surface-subtle inline-flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-sm border px-4 py-2.5"
        >
          <span
            class="text-caption text-text-muted font-mono font-semibold tracking-widest uppercase"
          >
            {location}
          </span>
          <span class="text-caption text-text-muted font-mono tracking-widest" aria-hidden="true"
            >·</span
          >
          <span
            class="text-caption text-text-muted font-mono font-semibold tracking-widest uppercase"
          >
            {headline}
          </span>
        </div>
      </div>

      {/* Right: avatar with manuscript caption */}
      <div class="flex items-start justify-center lg:col-span-5 lg:justify-end">
        <figure class="flex flex-col items-center gap-3 lg:items-end">
          <InteractiveAvatar size="lg" class="shrink-0" />
          <figcaption
            class="text-caption text-text-muted max-w-[200px] text-center font-mono tracking-wider uppercase lg:text-right"
          >
            Hover / focus to reveal
          </figcaption>
        </figure>
      </div>
    </div>
  </Container>
</section>
