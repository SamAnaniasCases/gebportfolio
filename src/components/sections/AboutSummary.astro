---
import Container from "../primitives/Container.astro";
import LinkButton from "../primitives/LinkButton.astro";
import { getEntry } from "astro:content";

// Fetch about page data singleton
const aboutEntry = await getEntry("pages", "about");
const aboutData = aboutEntry?.data;

const biographySection = aboutData?.sections?.find((s) => s.id === "biography");
const philosophySection = aboutData?.sections?.find((s) => s.id === "philosophy");

const focusAreas = [
  {
    title: "Web Standards & SSG",
    desc: "Astro, TypeScript, clean HTML, and CSS-first design systems.",
  },
  {
    title: "Software Architecture",
    desc: "Structured problem decomposition and maintainable system boundaries.",
  },
  {
    title: "Automated Verification",
    desc: "End-to-end testing, accessibility audits, and automated linting.",
  },
  {
    title: "AI-Paired Workflows",
    desc: "Human architectural ownership accelerated by interactive AI partners.",
  },
];
---

<section class="relative overflow-hidden py-10 md:py-14 lg:py-16">
  <Container width="default" class="space-y-12">
    <!-- Section Header -->
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div class="max-w-2xl space-y-3">
        <span class="text-caption text-primary font-mono font-semibold tracking-widest uppercase">
          05 · Background & Trajectory
        </span>
        <h2 class="text-h2 font-display text-text font-bold tracking-tight">
          05. Background & Trajectory
        </h2>
        <p class="text-body text-text-muted leading-relaxed">
          Educational foundation, engineering values, and active focus areas.
        </p>
      </div>
      <div>
        <LinkButton href="/about" variant="ghost" class="text-primary font-semibold">
          Read full background story →
        </LinkButton>
      </div>
    </div>

    <!-- Main Card Container -->
    <div
      class="bg-surface border-ink rounded-xl border-[2.5px] p-6 transition-all md:p-8"
      style="box-shadow: 3px 3px 0 var(--color-ink);"
    >
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Biography & Philosophy Column -->
        <div class="space-y-6 lg:col-span-7">
          <div class="space-y-3">
            <h3 class="text-h4 font-display text-text font-bold">
              {biographySection?.heading || "Biography"}
            </h3>
            <p class="text-body text-text-muted leading-relaxed">
              {
                biographySection?.content ||
                  "Sam Ananias Cases is a Bachelor of Industrial Technology major in Computer based in Cebu, Philippines. He focuses on software engineering fundamentals, problem decomposition, web standards, and leveraging AI as an interactive development partner."
              }
            </p>
          </div>

          <div class="border-ink/10 space-y-3 border-t pt-6">
            <h3 class="text-h4 font-display text-text font-bold">
              {philosophySection?.heading || "Engineering Philosophy"}
            </h3>
            <p class="text-body text-text-muted leading-relaxed">
              {
                philosophySection?.content ||
                  "I believe in building software thoughtfully—writing clear specifications, planning maintainable architecture, evaluating trade-offs, and verifying every build through rigorous automated testing."
              }
            </p>
          </div>
        </div>

        <!-- Focus Areas Column -->
        <div
          class="bg-surface-subtle/60 border-ink/15 space-y-4 rounded-lg border p-6 lg:col-span-5"
        >
          <h4 class="text-caption text-text font-mono font-semibold tracking-wider uppercase">
            Core Focus Areas
          </h4>
          <div class="space-y-4">
            {
              focusAreas.map((area) => (
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="text-primary font-mono text-xs font-bold">♞</span>
                    <span class="text-small font-display text-text font-bold">{area.title}</span>
                  </div>
                  <p class="text-caption text-text-muted pl-4 leading-normal">{area.desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
