---
import { getDoodleSvg } from "../../lib/icons/doodleRegistry";

interface Props {
  name: string;
  class?: string;
  size?: number | string;
  ariaLabel?: string;
}

const { name, class: className = "size-5", size, ariaLabel } = Astro.props;

const rawSvg = getDoodleSvg(name);

let processedSvg = "";
if (rawSvg) {
  processedSvg = rawSvg.replace(/<svg([^>]*)>/i, (_, attrs) => {
    const ariaAttr = ariaLabel
      ? `role="img" aria-label="${ariaLabel}"`
      : `aria-hidden="true" focusable="false"`;
    return `<svg ${attrs} class="size-full h-full w-full max-h-full max-w-full block object-contain" ${ariaAttr}>`;
  });
}
---

{
  processedSvg ? (
    <span
      class={`doodle-icon inline-flex shrink-0 items-center justify-center align-middle select-none ${className}`}
      style={
        size
          ? `width: ${typeof size === "number" ? `${size}px` : size}; height: ${typeof size === "number" ? `${size}px` : size};`
          : undefined
      }
    >
      <Fragment set:html={processedSvg} />
    </span>
  ) : null
}
