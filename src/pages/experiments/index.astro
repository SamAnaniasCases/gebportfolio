---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnderConstruction from "../../components/UnderConstruction.astro";

/**
 * Lab / Experiments — temporarily paused.
 * Original implementation preserved at src/content/_archive/experiments-index.astro.
 */
---

<BaseLayout
  title="Lab & Experiments"
  description="Sandbox prototypes, UI stress tests, and systems mockups — in development."
>
  <UnderConstruction
    eyebrow="Lab · Paused"
    title="This section is being built."
    summary="The lab bench is empty right now — and deliberately so. Experiments earn their listing when they can answer a specific question."
    description="When this reopens, expect work-in-progress prototypes, viewport stress tests, and half-formed components with architectural disclaimers attached. Until then, nothing here makes a claim it cannot back."
    piece="rook"
    eta="Under construction · bench cleared for the next experiment"
    cta={{ label: "Back to home", href: "/" }}
    secondaryCta={{ label: "View shipped work", href: "/projects" }}
  />
</BaseLayout>
