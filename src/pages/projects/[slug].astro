---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import LinkButton from "../../components/primitives/LinkButton.astro";
import ChessIcons from "../../components/navigation/ChessIcons.astro";
import DoodleIcon from "../../components/ui/DoodleIcon.astro";
import DividerChessboard from "../../components/primitives/DividerChessboard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Fetch all projects to compute Next/Prev links
const allProjects = await getCollection("projects");
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

// Fetch skills to map stack references to human-readable names
const skills = await getCollection("skills");
const skillMap = new Map(skills.map((s) => [s.id, s.data.name]));

// Chess Piece Meta Mapping (text label only — piece rendering handled by ChessIcons)
const chessRoleTitles: Record<string, string> = {
  king: "Signature System",
  queen: "Technical Powerhouse",
  knight: "Creative Optimization",
};
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <Container width="default" class="animate-reveal space-y-10 py-10 md:py-14">
    <!-- Back to archive navigation link -->
    <nav aria-label="Breadcrumb">
      <a
        href="/projects"
        class="text-small text-primary hover:text-primary-hover inline-flex items-center gap-1.5 font-bold transition-colors focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
      >
        <DoodleIcon name="arrows/arrow-left" class="size-3.5" />
        <span>Back to projects</span>
      </a>
    </nav>

    <!-- Case Study Header Section -->
    <header class="space-y-6">
      <!-- Eyebrow & Status Badge Row -->
      <div class="flex flex-wrap items-center gap-3">
        <span
          class={`text-micro font-bold border rounded-full px-2.5 py-0.5 uppercase tracking-wider font-mono ${
            project.data.status === "active"
              ? "bg-primary/10 border-primary/20 text-primary"
              : "bg-surface-subtle border-border-custom text-text-muted"
          }`}
        >
          {project.data.status}
        </span>

        {
          project.data.chessPiece && (
            <span class="bg-primary/10 border-primary/20 text-primary text-micro inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-mono font-bold tracking-wider uppercase">
              <ChessIcons piece={project.data.chessPiece} class="size-3 shrink-0" />
              <span>{chessRoleTitles[project.data.chessPiece]}</span>
            </span>
          )
        }
      </div>

      <!-- Title & Summary -->
      <div class="space-y-3">
        <h1
          class="text-h1 font-display text-text leading-tight font-extrabold tracking-tight text-balance"
        >
          {project.data.title}
        </h1>
        <p class="text-body-large text-text-muted max-w-3xl leading-relaxed">
          {project.data.summary}
        </p>
      </div>

      <!-- Executive Summary / Key Takeaway Callout Box -->
      {
        project.data.keyTakeaway && (
          <blockquote class="border-primary bg-surface-subtle/80 text-body text-text border-l-[var(--stroke-structural)] p-5 leading-relaxed font-medium">
            {project.data.keyTakeaway}
          </blockquote>
        )
      }

      <!-- Hero Image Banner -->
      {
        project.data.heroImage && (
          <div
            class="border-border-custom relative overflow-hidden rounded-md border-[var(--stroke-structural)]"
            style="box-shadow: 4px 4px 0 var(--color-ink);"
          >
            <img
              src={project.data.heroImage}
              alt={project.data.title}
              class="max-h-[440px] w-full object-cover"
            />
          </div>
        )
      }
    </header>

    <!-- Main Content & Sticky Engraved Sidebar Grid -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Main Prose Narrative (Col 1-8) -->
      <div class="space-y-10 lg:col-span-8">
        <article class="prose-custom text-body text-text-muted max-w-[68ch] leading-relaxed">
          <Content />
        </article>

        <!-- Key Outcomes Box -->
        {
          project.data.outcomes && project.data.outcomes.length > 0 && (
            <div
              class="bg-surface border-border-custom space-y-5 rounded-md border-[var(--stroke-structural)] p-6"
              style="box-shadow: 3px 3px 0 var(--color-ink);"
            >
              <h3 class="text-h3 font-display text-text flex items-center gap-2.5 font-bold">
                <DoodleIcon name="interface/target" class="text-primary size-6 shrink-0" />
                Key project outcomes
              </h3>
              <ul class="space-y-3">
                {project.data.outcomes.map((outcome) => (
                  <li class="text-body text-text flex items-start gap-3">
                    <DoodleIcon name="interface/tick" class="text-primary mt-0.5 size-5 shrink-0" />
                    <span>{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <!-- Sticky Engraved Sidebar (Col 9-12) -->
      <aside class="space-y-6 lg:col-span-4">
        <div
          class="bg-surface border-border-custom sticky top-24 space-y-6 rounded-md border-[var(--stroke-structural)] p-6"
          style="box-shadow: 3px 3px 0 var(--color-ink);"
        >
          <h3 class="text-h4 font-display text-text border-border-custom border-b pb-3 font-bold">
            Project metadata
          </h3>

          <!-- Role -->
          <div class="flex items-start gap-3">
            <DoodleIcon name="interface/suitcase" class="text-text-muted mt-1 size-5 shrink-0" />
            <div>
              <span class="text-caption text-text-muted block font-mono tracking-wider uppercase"
                >Role</span
              >
              <span class="text-small text-text font-medium">{project.data.role}</span>
            </div>
          </div>

          <!-- Duration -->
          <div class="flex items-start gap-3">
            <DoodleIcon name="interface/calendar" class="text-text-muted mt-1 size-5 shrink-0" />
            <div>
              <span class="text-caption text-text-muted block font-mono tracking-wider uppercase"
                >Duration</span
              >
              <span class="text-small text-text font-medium">{project.data.dates}</span>
            </div>
          </div>

          <!-- Tech Stack -->
          {
            project.data.stackRefs && project.data.stackRefs.length > 0 && (
              <div class="flex items-start gap-3">
                <DoodleIcon name="e-commerce/tag" class="text-text-muted mt-1 size-5 shrink-0" />
                <div class="space-y-2">
                  <span class="text-caption text-text-muted block font-mono tracking-wider uppercase">
                    Technology stack
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.stackRefs.map((ref) => (
                      <span class="bg-surface-subtle border-border-custom text-caption text-text-muted rounded border px-2 py-0.5 font-mono">
                        {skillMap.get(ref) || ref}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            )
          }

          <!-- External Links -->
          {
            project.data.links && project.data.links.length > 0 && (
              <div class="border-border-custom flex items-start gap-3 border-t pt-4">
                <DoodleIcon name="interface/link" class="text-text-muted mt-1 size-5 shrink-0" />
                <div class="w-full space-y-3">
                  <span class="text-caption text-text-muted block font-mono tracking-wider uppercase">
                    Project links
                  </span>
                  <div class="flex w-full flex-col gap-2">
                    {project.data.links.map((link) => (
                      <LinkButton
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        variant="secondary"
                        size="sm"
                        class="w-full justify-center"
                      >
                        {link.label}
                        <DoodleIcon name="arrows/arrow-ne" class="ml-1 size-3.5" />
                      </LinkButton>
                    ))}
                  </div>
                </div>
              </div>
            )
          }

          <!-- Strategic Chess Piece Badge & Definition Card -->
          {
            project.data.chessPiece && project.data.chessRoleReason && (
              <div class="bg-surface-subtle/80 border-border-custom space-y-3 rounded-md border-[var(--stroke-detail)] p-4">
                <div class="flex items-center gap-2.5">
                  <div class="text-primary size-8 shrink-0">
                    <ChessIcons
                      piece={project.data.chessPiece}
                      variant="woodcut"
                      class="size-full"
                    />
                  </div>
                  <span class="text-small font-display text-text font-bold">
                    {chessRoleTitles[project.data.chessPiece]}
                  </span>
                </div>
                <p class="text-caption text-text-muted leading-relaxed font-normal">
                  {project.data.chessRoleReason}
                </p>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <DividerChessboard class="mt-2 mb-2 opacity-70" />

    <!-- Next / Previous Case Study Pagination Footer -->
    <nav aria-label="Case study pagination" class="flex flex-col justify-between gap-6 sm:flex-row">
      <div class="flex-1">
        {
          prevProject && (
            <a
              href={`/projects/${prevProject.id}`}
              class="group flex flex-col space-y-1.5 text-left focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
            >
              <span class="text-caption text-text-muted inline-flex items-center gap-1.5 font-mono font-bold tracking-wider uppercase">
                <DoodleIcon name="arrows/arrow-left" class="size-3" />
                Previous case study
              </span>
              <span class="text-small text-primary font-display font-bold group-hover:underline">
                {prevProject.data.title}
              </span>
            </a>
          )
        }
      </div>

      <div class="flex-1 sm:text-right">
        {
          nextProject && (
            <a
              href={`/projects/${nextProject.id}`}
              class="group flex flex-col space-y-1.5 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
            >
              <span class="text-caption text-text-muted inline-flex items-center justify-end gap-1.5 font-mono font-bold tracking-wider uppercase">
                Next case study
                <DoodleIcon name="arrows/arrow-right" class="size-3" />
              </span>
              <span class="text-small text-primary font-display font-bold group-hover:underline">
                {nextProject.data.title}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </Container>
</BaseLayout>
