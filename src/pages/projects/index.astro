---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import DoodleIcon from "../../components/ui/DoodleIcon.astro";
import ChessIcons from "../../components/navigation/ChessIcons.astro";
import Logo from "../../components/primitives/Logo.astro";
import AvegaLogo from "../../components/ui/AvegaLogo.astro";
import { getCollection } from "astro:content";

// Retrieve all projects
const projects = await getCollection("projects");

// Categorize projects
const featuredProjects = projects.filter((p) => p.data.featured);
const kingProject = featuredProjects.find((p) => p.data.chessPiece === "king");
const queenProject = featuredProjects.find((p) => p.data.chessPiece === "queen");
const knightProject = featuredProjects.find((p) => p.data.chessPiece === "knight");

const topFeatured = [kingProject, queenProject, knightProject].filter(
  (p): p is (typeof projects)[0] => Boolean(p)
);
const topFeaturedIds = new Set(topFeatured.map((p) => p.id));
const secondaryProjects = projects.filter((p) => !topFeaturedIds.has(p.id));

// Quick Stats
const totalCount = projects.length;
const activeCount = projects.filter((p) => p.data.status === "active").length;
const featuredCount = topFeatured.length;

const PIECE_TITLES: Record<string, { label: string; short: string }> = {
  king: { label: "Signature System", short: "King" },
  queen: { label: "Technical Powerhouse", short: "Queen" },
  knight: { label: "Creative Optimization", short: "Knight" },
};
---

<BaseLayout
  title="Case Studies & Projects"
  description="Curated case studies, software systems, and architectural specifications built by Sam Ananias Cases."
>
  <Container width="default" class="animate-reveal space-y-12 py-10 md:py-14">
    <!-- Header & Quick Stats Bar -->
    <header class="space-y-6">
      <div class="space-y-3">
        <h1 class="text-h1 font-display text-text font-bold tracking-tight text-balance">
          Case Studies & Projects
        </h1>
        <p class="text-body-large text-text-muted max-w-3xl leading-relaxed">
          A curated catalog of software systems, web applications, and architectural
          specifications—built with specification discipline, trade-off analysis, and automated
          verification.
        </p>
      </div>

      <!-- Decorative hatch rule -->
      <div class="bg-border-custom h-[var(--stroke-hatch)] w-full" aria-hidden="true"></div>

      <!-- Quick Stats Pills -->
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
        <span
          class="border-border-custom bg-surface-subtle text-text inline-flex items-center gap-2 rounded-full border px-3 py-1 font-semibold"
        >
          <DoodleIcon name="interface/checklist" class="text-primary size-3.5 shrink-0" />
          <span>{totalCount} Total Projects</span>
        </span>
        <span
          class="border-border-custom bg-surface-subtle text-text inline-flex items-center gap-2 rounded-full border px-3 py-1 font-semibold"
        >
          <DoodleIcon name="interface/target" class="text-primary size-3.5 shrink-0" />
          <span>{activeCount} Active Systems</span>
        </span>
        <span
          class="border-border-custom bg-surface-subtle text-text inline-flex items-center gap-2 rounded-full border px-3 py-1 font-semibold"
        >
          <ChessIcons piece="king" class="text-primary size-3.5 shrink-0" />
          <span>{featuredCount} Signature Featured Cases</span>
        </span>
      </div>
    </header>

    <!-- Interactive Filter & Search Controls Bar -->
    <section
      aria-labelledby="filter-bar-heading"
      class="bg-surface border-border-custom space-y-4 rounded-md border-[var(--stroke-structural)] p-4 md:p-5"
    >
      <h2 id="filter-bar-heading" class="sr-only">Filter and search projects</h2>
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <!-- Category Filter Tabs -->
        <div
          role="tablist"
          aria-label="Project categories"
          class="flex flex-wrap items-center gap-2"
          id="category-tabs"
        >
          <button
            role="tab"
            aria-selected="true"
            data-category="all"
            class="filter-tab active bg-primary text-surface cursor-pointer rounded-full px-3.5 py-1.5 font-mono text-xs font-bold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
          >
            All Work
          </button>
          <button
            role="tab"
            aria-selected="false"
            data-category="architecture"
            class="filter-tab bg-surface-subtle border-border-custom text-text-muted hover:text-text cursor-pointer rounded-full border px-3.5 py-1.5 font-mono text-xs font-semibold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
          >
            Architecture
          </button>
          <button
            role="tab"
            aria-selected="false"
            data-category="web"
            class="filter-tab bg-surface-subtle border-border-custom text-text-muted hover:text-text cursor-pointer rounded-full border px-3.5 py-1.5 font-mono text-xs font-semibold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
          >
            Web Apps
          </button>
        </div>

        <!-- Real-time Search Input -->
        <div class="relative min-w-[240px] md:w-72">
          <label
            for="search-input"
            class="text-caption text-text-muted mb-1 block font-mono font-bold tracking-wider uppercase"
          >
            Search the archive
          </label>
          <div class="relative">
            <input
              type="search"
              id="search-input"
              name="project-search"
              placeholder="Title, technology, or tag..."
              autocomplete="off"
              class="bg-surface-subtle border-border-custom text-text placeholder:text-text-muted/60 text-small focus:border-primary w-full rounded-md border py-2 pr-3 pl-8 font-mono focus:outline-2 focus:outline-offset-2 focus:outline-[var(--color-focus)]"
            />
            <span
              class="text-text-muted pointer-events-none absolute top-1/2 left-2.5 flex -translate-y-1/2 items-center"
            >
              <DoodleIcon name="interface/search" class="size-4" />
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Top Featured Showcase Section -->
    <section class="space-y-6" id="featured-showcase-section" aria-labelledby="featured-heading">
      <div class="border-border-custom flex items-baseline justify-between gap-4 border-b pb-3">
        <h2 id="featured-heading" class="text-h2 font-display text-text font-bold tracking-tight">
          Featured case studies
        </h2>
        <span class="text-caption text-text-muted font-mono tracking-wider uppercase">
          Signature work
        </span>
      </div>

      <!-- 2-Column Grid for Featured Projects -->
      <div class="grid grid-cols-1 items-stretch gap-6 pt-2 pb-2 md:grid-cols-2">
        {/* King Signature Hero Card (BITS) */}
        {
          kingProject && (
            <article
              data-project-card
              data-category={kingProject.data.category}
              data-status={kingProject.data.status}
              data-search-text={`${kingProject.data.title} ${kingProject.data.summary} ${kingProject.data.tags.join(" ")}`}
              class="group bg-surface border-primary hover:border-primary/70 relative flex cursor-pointer flex-col justify-between overflow-hidden rounded-xl border-[var(--stroke-structural)] p-5 transition-all duration-300 hover:-translate-y-1 md:p-6"
              style="box-shadow: 3px 3px 0 var(--color-ink);"
            >
              <div class="relative z-10 space-y-4">
                {/* Header Pills Row */}
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2 font-mono text-xs">
                    <span class="bg-primary text-surface inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 font-bold tracking-wider uppercase">
                      <ChessIcons piece="king" class="size-3.5 shrink-0" />
                      <span>{PIECE_TITLES.king.label}</span>
                    </span>
                    <span class="border-border-custom bg-surface-subtle text-text-muted text-micro hidden rounded-md border px-2.5 py-1 font-mono font-semibold tracking-wider uppercase sm:inline-flex">
                      AVEGA SHIPPING
                    </span>
                  </div>
                  <span
                    class={`text-micro shrink-0 rounded-full border px-2.5 py-0.5 font-mono font-bold tracking-wider uppercase ${
                      kingProject.data.status === "active"
                        ? "border-primary/20 bg-primary/10 text-primary"
                        : "border-border-custom bg-surface-subtle text-text-muted"
                    }`}
                  >
                    {kingProject.data.status}
                  </span>
                </div>

                {/* Horizontal Content Row: Full-bleed App Icon Logo on LEFT */}
                <div class="flex items-start gap-4 pt-1">
                  {/* Left: Edge-to-Edge App Icon Container */}
                  <div class="border-border-custom relative flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border md:size-20">
                    <AvegaLogo size="full" class="h-full w-full" />
                  </div>

                  {/* Right: Title & Description */}
                  <div class="min-w-0 flex-1 space-y-1.5">
                    <h3 class="text-h3 font-display text-text group-hover:text-primary leading-tight font-bold transition-colors">
                      <a
                        href={`/projects/${kingProject.id}`}
                        class="focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
                      >
                        {kingProject.data.title}
                      </a>
                    </h3>
                    <p class="text-small text-text-muted line-clamp-3 leading-relaxed">
                      {kingProject.data.summary}
                    </p>
                  </div>
                </div>
              </div>

              {/* Interactive Hover Peek Window (Full uncropped picture) */}
              {kingProject.data.heroImage && (
                <div
                  class="peek-window border-primary/60 bg-surface pointer-events-none absolute top-14 right-4 z-30 hidden w-72 translate-y-4 scale-90 overflow-hidden rounded-xl border-2 opacity-0 shadow-2xl transition-all duration-300 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 md:w-80 lg:block lg:w-[380px]"
                  style="box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);"
                >
                  <div class="border-border-custom bg-surface-subtle/95 text-text-muted flex items-center justify-between border-b px-3.5 py-2 font-mono text-[11px] font-bold tracking-wider uppercase">
                    <span class="text-primary flex items-center gap-1.5">
                      <DoodleIcon name="interface/search" class="size-3.5" />
                      <span>Full Work Preview</span>
                    </span>
                    <span class="text-caption font-bold">FULL PICTURE</span>
                  </div>
                  <div class="bg-surface-subtle relative w-full overflow-hidden p-1.5">
                    <img
                      src={kingProject.data.heroImage}
                      alt={`${kingProject.data.title} full screenshot preview`}
                      class="h-auto max-h-[380px] w-full rounded-lg object-contain transition-transform duration-500 group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}

              <div class="border-border-custom relative z-10 mt-4 flex items-center justify-between border-t pt-4">
                <a
                  href={`/projects/${kingProject.id}`}
                  class="text-small text-primary inline-flex items-center gap-1.5 font-bold transition-colors group-hover:underline"
                >
                  <span>Read case study</span>
                  <DoodleIcon
                    name="arrows/arrow-right"
                    class="size-3.5 transition-transform group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </article>
          )
        }

        {/* Queen Card (Portfolio Architecture) */}
        {
          queenProject && (
            <article
              data-project-card
              data-category={queenProject.data.category}
              data-status={queenProject.data.status}
              data-search-text={`${queenProject.data.title} ${queenProject.data.summary} ${queenProject.data.tags.join(" ")}`}
              class="group bg-surface border-border-custom hover:border-primary/70 relative flex cursor-pointer flex-col justify-between overflow-hidden rounded-xl border-[var(--stroke-structural)] p-5 transition-all duration-300 hover:-translate-y-1 md:p-6"
              style="box-shadow: 3px 3px 0 var(--color-ink);"
            >
              <div class="relative z-10 space-y-4">
                {/* Header Pills Row */}
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2 font-mono text-xs">
                    <span class="text-primary bg-primary/10 border-primary/20 inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 font-bold tracking-wider uppercase">
                      <ChessIcons piece="queen" class="size-3.5 shrink-0" />
                      <span>{PIECE_TITLES.queen.label}</span>
                    </span>
                    <span class="border-border-custom bg-surface-subtle text-text-muted text-micro hidden rounded-md border px-2.5 py-1 font-mono font-semibold tracking-wider uppercase sm:inline-flex">
                      ASTRO V5 ARCHITECTURE
                    </span>
                  </div>
                  <span
                    class={`text-micro shrink-0 rounded-full border px-2 py-0.5 font-mono font-bold tracking-wider uppercase ${
                      queenProject.data.status === "active"
                        ? "border-primary/20 bg-primary/10 text-primary"
                        : "border-border-custom bg-surface-subtle text-text-muted"
                    }`}
                  >
                    {queenProject.data.status}
                  </span>
                </div>

                {/* Horizontal Content Row: Full App Icon Logo on LEFT */}
                <div class="flex items-start gap-4 pt-1">
                  {/* Left: App Icon / Logo Thumbnail */}
                  <div class="border-border-custom bg-surface-subtle relative flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border md:size-20">
                    <Logo class="text-text h-full w-full object-contain p-2.5 transition-transform group-hover:scale-105" />
                  </div>

                  {/* Right: Title & Description */}
                  <div class="min-w-0 flex-1 space-y-1.5">
                    <h3 class="text-h3 font-display text-text group-hover:text-primary leading-tight font-bold transition-colors">
                      <a
                        href={`/projects/${queenProject.id}`}
                        class="focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
                      >
                        {queenProject.data.title}
                      </a>
                    </h3>
                    <p class="text-small text-text-muted line-clamp-3 leading-relaxed">
                      {queenProject.data.summary}
                    </p>
                  </div>
                </div>
              </div>

              {/* Interactive Hover Peek Window (Full uncropped picture) */}
              {queenProject.data.heroImage && (
                <div
                  class="peek-window border-primary/60 bg-surface pointer-events-none absolute top-14 right-4 z-30 hidden w-72 translate-y-4 scale-90 overflow-hidden rounded-xl border-2 opacity-0 shadow-2xl transition-all duration-300 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 md:w-80 lg:block lg:w-[380px]"
                  style="box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);"
                >
                  <div class="border-border-custom bg-surface-subtle/95 text-text-muted flex items-center justify-between border-b px-3.5 py-2 font-mono text-[11px] font-bold tracking-wider uppercase">
                    <span class="text-primary flex items-center gap-1.5">
                      <DoodleIcon name="interface/search" class="size-3.5" />
                      <span>Full Work Preview</span>
                    </span>
                    <span class="text-caption font-bold">FULL PICTURE</span>
                  </div>
                  <div class="bg-surface-subtle relative w-full overflow-hidden p-1.5">
                    <img
                      src={queenProject.data.heroImage}
                      alt={`${queenProject.data.title} full screenshot preview`}
                      class="h-auto max-h-[380px] w-full rounded-lg object-contain transition-transform duration-500 group-hover:scale-[1.02]"
                      loading="lazy"
                    />
                  </div>
                </div>
              )}

              <div class="border-border-custom relative z-10 mt-4 flex items-center justify-between border-t pt-4">
                <a
                  href={`/projects/${queenProject.id}`}
                  class="text-small text-primary inline-flex items-center gap-1.5 font-bold transition-colors group-hover:underline"
                >
                  <span>Read case study</span>
                  <DoodleIcon
                    name="arrows/arrow-right"
                    class="size-3.5 transition-transform group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </article>
          )
        }
      </div>
    </section>

    <!-- Secondary Projects Archive (Vertical List Layout) -->
    <section class="space-y-6" id="secondary-archive-section" aria-labelledby="archive-heading">
      <div class="border-border-custom flex items-baseline justify-between gap-4 border-b pb-3">
        <h2 id="archive-heading" class="text-h2 font-display text-text font-bold tracking-tight">
          All projects archive
        </h2>
        <span class="text-caption text-text-muted font-mono tracking-wider uppercase">
          Complete ledger
        </span>
      </div>

      <div class="border-border-custom divide-border-custom bg-surface divide-y rounded-md border">
        {
          secondaryProjects.length === 0 ? (
            <div class="text-text-muted text-small p-8 text-center">
              <DoodleIcon
                name="interface/file-list"
                class="text-text-muted mx-auto mb-3 size-8 opacity-50"
              />
              <p class="font-display text-h4 text-text font-bold">No further entries</p>
              <p class="text-small text-text-muted mt-1">
                The featured cases above carry the weight of this catalog for now.
              </p>
            </div>
          ) : (
            secondaryProjects.map((project) => (
              <article
                data-project-card
                data-category={project.data.category}
                data-status={project.data.status}
                data-search-text={`${project.data.title} ${project.data.summary} ${project.data.tags.join(" ")}`}
                class="group hover:bg-surface-subtle/60 relative flex cursor-pointer flex-col justify-between gap-4 p-4 transition-colors md:flex-row md:items-center md:p-5"
              >
                <div class="space-y-1.5 md:max-w-2xl">
                  <div class="text-text-muted flex flex-wrap items-center gap-2.5 font-mono text-xs">
                    <span class="text-caption font-semibold tracking-wider uppercase">
                      {project.data.dates}
                    </span>
                    <span class="text-primary bg-primary/10 border-primary/20 text-micro rounded border px-2 py-0.5 font-bold tracking-wider uppercase">
                      {project.data.category}
                    </span>
                    <span
                      class={`text-micro rounded-full border px-2 py-0.5 font-mono font-bold tracking-wider uppercase ${
                        project.data.status === "active"
                          ? "border-primary/20 bg-primary/10 text-primary"
                          : "border-border-custom bg-surface-subtle text-text-muted"
                      }`}
                    >
                      {project.data.status}
                    </span>
                  </div>

                  <h3 class="text-h4 font-display text-text group-hover:text-primary font-bold transition-colors">
                    <a
                      href={`/projects/${project.id}`}
                      class="focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="text-small text-text-muted line-clamp-2 leading-relaxed">
                    {project.data.summary}
                  </p>
                </div>

                {/* Interactive Peek Window for Archive Projects (Full uncropped picture) */}
                {project.data.heroImage && (
                  <div
                    class="peek-window border-primary/60 bg-surface pointer-events-none absolute top-2 right-24 z-30 hidden w-72 translate-y-3 scale-90 overflow-hidden rounded-xl border-2 opacity-0 shadow-2xl transition-all duration-300 group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 md:w-80 lg:block"
                    style="box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);"
                  >
                    <div class="border-border-custom bg-surface-subtle/95 text-text-muted flex items-center justify-between border-b px-3.5 py-1.5 font-mono text-[10px] font-bold tracking-wider uppercase">
                      <span class="text-primary flex items-center gap-1.5">
                        <DoodleIcon name="interface/search" class="size-3" />
                        <span>Work Preview</span>
                      </span>
                    </div>
                    <div class="bg-surface-subtle relative w-full overflow-hidden p-1">
                      <img
                        src={project.data.heroImage}
                        alt={`${project.data.title} full screenshot preview`}
                        class="h-auto max-h-[300px] w-full rounded-lg object-contain transition-transform duration-500 group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    </div>
                  </div>
                )}

                <div class="flex shrink-0 items-center gap-4">
                  <a
                    href={`/projects/${project.id}`}
                    class="text-small text-primary inline-flex items-center gap-1.5 font-bold transition-colors group-hover:underline"
                  >
                    <span>Read case study</span>
                    <DoodleIcon
                      name="arrows/arrow-right"
                      class="size-3.5 transition-transform group-hover:translate-x-0.5"
                    />
                  </a>
                </div>
              </article>
            ))
          )
        }
      </div>

      <!-- Empty state: revealed by JS when filter+search hides all cards -->
      <div
        id="projects-empty-state"
        class="border-border-custom bg-surface-subtle hidden rounded-md border p-10 text-center"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        <ChessIcons
          piece="pawn"
          variant="woodcut"
          class="text-text-muted mx-auto mb-3 size-12 opacity-60"
        />
        <p class="font-hand text-h4 text-primary block origin-left -rotate-1">
          No moves match that line.
        </p>
        <p class="text-body text-text-muted mt-3">
          Nothing in the catalog matches your current filter. Try a different combination, or
          <button
            type="button"
            id="reset-filter-btn"
            class="text-primary ml-1 font-semibold underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
          >
            reset to All Work
          </button>.
        </p>
      </div>
    </section>
  </Container>

  <!-- Client-side Script for Live Filtering, Real-time Search, and Cursor Swipe Peek Animation -->
  <script is:inline>
    const tabs = Array.from(document.querySelectorAll("#category-tabs [role='tab']"));
    const searchInput = document.getElementById("search-input");
    const cards = document.querySelectorAll("[data-project-card]");
    const emptyState = document.getElementById("projects-empty-state");
    const resetBtn = document.getElementById("reset-filter-btn");

    let activeCategory = "all";

    const activeTabCls =
      "filter-tab active bg-primary text-surface cursor-pointer rounded-full px-3.5 py-1.5 font-mono text-xs font-bold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]";
    const idleTabCls =
      "filter-tab bg-surface-subtle border-border-custom text-text-muted hover:text-text cursor-pointer rounded-full border px-3.5 py-1.5 font-mono text-xs font-semibold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]";

    function setActiveTab(target) {
      tabs.forEach((t) => {
        const isActive = t === target;
        t.className = isActive ? activeTabCls : idleTabCls;
        t.setAttribute("aria-selected", isActive ? "true" : "false");
      });
    }

    function filterProjects() {
      const query = (searchInput?.value || "").toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const category = card.getAttribute("data-category");
        const searchText = (card.getAttribute("data-search-text") || "").toLowerCase();

        const matchesCategory = activeCategory === "all" || category === activeCategory;
        const matchesSearch = !query || searchText.includes(query);

        if (matchesCategory && matchesSearch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount !== 0);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        setActiveTab(tab);
        activeCategory = tab.getAttribute("data-category") || "all";
        filterProjects();
      });
    });

    searchInput?.addEventListener("input", filterProjects);

    resetBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      activeCategory = "all";
      const allTab = document.querySelector('[data-category="all"]');
      if (allTab) setActiveTab(allTab);
      filterProjects();
      searchInput?.focus();
    });

    // Interactive Swipe & Parallax Cursor Hover Peek Animation
    cards.forEach((card) => {
      const peekWin = card.querySelector(".peek-window");
      if (!peekWin) return;

      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        // Calculate offset percentage (-15px to 15px shift)
        const xOffset = (x / rect.width - 0.5) * 20;
        const yOffset = (y / rect.height - 0.5) * 16;
        const rotate = (x / rect.width - 0.5) * 4;

        peekWin.style.transform = `translate3d(${xOffset}px, ${yOffset}px, 0) rotate(${rotate}deg) scale(1.02)`;
      });

      card.addEventListener("mouseleave", () => {
        peekWin.style.transform = "";
      });
    });
  </script>
</BaseLayout>
