---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/primitives/Container.astro";
import DividerChessboard from "../components/primitives/DividerChessboard.astro";
import AboutHero from "../components/sections/about/AboutHero.astro";
import MoveLedger from "../components/sections/about/MoveLedger.astro";
import FactsIndex from "../components/sections/about/FactsIndex.astro";
// import CredentialsFootnote from "../components/sections/about/CredentialsFootnote.astro";
import { getEntry } from "astro:content";

const aboutEntry = await getEntry("pages", "about");
const aboutData = aboutEntry?.data;

const moves = aboutData?.moves ?? [];
const facts = aboutData?.facts ?? [];

// const achievements = await getCollection("achievements");

const pageTitle = aboutData?.title ?? "About Sam Ananias Cases";
const pageDescription =
  "A chess-notation ledger of Sam Ananias Cases: the openings played, the internship shipped, the discipline being built, and the endgame in view.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Hero */}
  <AboutHero />

  <Container width="default" class="pb-20">
    {/* Section rule */}
    <DividerChessboard class="mb-14 opacity-70 md:mb-20" />

    {/* Ledger + facts index side-by-side on desktop, stacked on mobile */}
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      {/* Main move ledger */}
      <div class="lg:col-span-8">
        <header class="mb-10 space-y-2 md:mb-12">
          <p class="text-caption text-text-muted font-mono font-bold tracking-[0.18em] uppercase">
            Career move ledger · six moves · 2025 – present
          </p>
          <h2 class="text-h2 font-display text-text font-bold tracking-tight">
            The career as a move ledger
          </h2>
          <p class="text-body text-text-muted max-w-[62ch] leading-relaxed">
            Career moves annotated step-by-step: each entry carries its reasoning, its evidence, and
            its date range. No move is wasted, none is taken back.
          </p>
        </header>

        {
          moves.length > 0 ? (
            <MoveLedger moves={moves} />
          ) : (
            <div class="border-border-custom bg-surface-subtle/60 rounded-sm border p-6">
              <p class="font-hand text-h4 text-primary">No moves recorded yet.</p>
              <p class="text-small text-text-muted mt-2">
                This score sheet is still being prepared. The shape is set; the content is on the
                way.
              </p>
            </div>
          )
        }
      </div>

      {/* Facts quick-reference sidebar (sticky on desktop) */}
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-8">
          <FactsIndex facts={facts} />

          {/* Small chess coordinate strip */}
          <div
            class="border-border-custom mt-6 grid grid-cols-8 overflow-hidden rounded-sm border"
            aria-hidden="true"
          >
            {
              ["a", "b", "c", "d", "e", "f", "g", "h"].map((file, i) => (
                <span
                  class={`text-micro flex aspect-square items-center justify-center font-mono font-bold tracking-[0.2em] uppercase ${
                    i % 2 === 0 ? "bg-surface text-text-muted" : "bg-text text-bg"
                  }`}
                >
                  {file}
                </span>
              ))
            }
          </div>
        </div>
      </aside>
    </div>

    {/* Footnote credentials (commented out until certifications are acquired) */}
    {
      /*
      achievements.length > 0 && (
        <div class="mt-20 md:mt-24">
          <CredentialsFootnote achievements={achievements} />
        </div>
      )
    */
    }

  </Container>
</BaseLayout>
