---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/primitives/Container.astro";
import { getCollection } from "astro:content";
import { Scroll3DKingCanvas } from "../components/experience/Scroll3DKingCanvas";
import { ExperienceTimeline } from "../components/experience/ExperienceTimeline";

// Get experience history
const experiences = await getCollection("experience");
const sortedExperiences = experiences.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Fetch skills to resolve references
const skills = await getCollection("skills");
const skillMapObject: Record<string, string> = {};
skills.forEach((s) => {
  skillMapObject[s.id] = s.data.name;
});

// Serialize experiences for React island props
const serializedExperiences = sortedExperiences.map((exp) => ({
  id: exp.id,
  organization: exp.data.organization,
  role: exp.data.role,
  type: exp.data.type,
  start: exp.data.start,
  end: exp.data.end,
  location: exp.data.location,
  summary: exp.data.summary,
  achievements: exp.data.achievements,
  skills: exp.data.skills,
  url: exp.data.url,
  order: exp.data.order ?? 0,
}));
---

<BaseLayout title="My Experience">
  <!-- 3D WebGL King Scrollbar Companion -->
  <Scroll3DKingCanvas client:only="react" />

  <Container width="default" class="animate-reveal space-y-12 py-12">
    <!-- Header -->
    <header class="border-border-custom space-y-3 border-b pb-6">
      <h1 class="text-h1 font-display text-text font-bold tracking-tight">Professional History</h1>
      <p class="text-body-large text-text-muted max-w-2xl leading-relaxed">
        My authentic engineering timeline, academic achievements, technical projects, and applied
        technologies.
      </p>
    </header>

    <!-- Interactive Experience Timeline with Category & Skill Filters -->
    <ExperienceTimeline client:load experiences={serializedExperiences} skillMap={skillMapObject} />
  </Container>
</BaseLayout>
